# 复制成 .env 再改:cp .env.example .env
# .env 已被 .gitignore 排除,里面的订阅地址不会入库。

# 面板密码,必填。面板明文显示 API Key 和订阅地址,别用弱密码。
PANEL_USER=admin
PANEL_PASS=

# 机场订阅地址(Clash/mihomo 格式)。留空也能启动,之后在面板「配置」里填。
# 只在首次启动播种,之后以卷里的 config.json 为准。
SUBSCRIPTION_URL=

# 对外 API Key,留空则首次启动自动生成,面板里可查可换。
API_KEY=

# 以下都可以不填,列出来是为了知道能调什么。
# 测速探针:这条请求是走节点发出去的,所以国内直连不到 gstatic 无所谓。
# NODE_TEST_URL=http://www.gstatic.com/generate_204
# NODE_TEST_TIMEOUT_MS=5000
# 设成 0 则不把上游的推理内容转给客户端(Anthropic 协议下就是 thinking 块)。
# SHOW_THINKING=1
