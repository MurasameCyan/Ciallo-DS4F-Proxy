# 复制成 .env 再改:cp .env.example .env
# .env 已被 .gitignore 排除,里面的订阅地址不会入库。

# 面板密码,必填。面板明文显示 API Key 和订阅地址,别用弱密码。
PANEL_USER=admin
PANEL_PASS=

# 机场订阅地址(Clash/mihomo 格式)。留空也能启动,之后在面板「配置」里填。
# 只在首次启动播种,之后以卷里的 config.json 为准。
SUBSCRIPTION_URL=

# 对外 API Key,留空则首次启动自动生成,面板里可查可换。
API_KEY=

# 以下都可以不填,列出来是为了知道能调什么。
# 延迟探针地址。这条请求是走节点发出去的,所以你本机连不连得上无所谓。
# 默认打上游站点根路径(HEAD,不碰 /zen/v1,不花额度)。别改成
# gstatic.com/generate_204:机场封 80 端口、劫持 Google 域名都很常见,
# 实测会让整份订阅「全部测不通」,而同一批节点跑上游是好的。
# NODE_TEST_URL=https://opencode.ai/
# 单次探测超时,取值夹在 1000–8000 之间。超时算不可用。
# NODE_TEST_TIMEOUT_MS=5000
# 设成 0 则不把上游的推理内容转给客户端(Anthropic 协议下就是 thinking 块)。
# SHOW_THINKING=1

# 面板右上角「检查更新」跟谁比。改成自己的 fork 就查自己的那份。
# GITHUB_REPO=MurasameCyan/Ciallo-DS4F-Proxy
# GITHUB_TRACK_REF=beta
